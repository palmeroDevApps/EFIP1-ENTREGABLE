        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    Rol ||--|{ RolPermiso : \&quot;asigna\&quot;\n    Permiso ||--o{ RolPermiso : \&quot;otorga\&quot;\n    Rol ||--o{ Usuario : \&quot;asigna\&quot;\n\n    Marca ||--o{ Producto : \&quot;clasifica\&quot;\n    TipoProducto ||--o{ Producto : \&quot;categoriza\&quot;\n\n    Proveedor ||--o{ Compra : \&quot;abastece\&quot;\n    Usuario ||--o{ Compra : \&quot;asienta\&quot;\n    Compra ||--|{ DetalleCompra : \&quot;conforma\&quot;\n    Producto ||--o{ DetalleCompra : \&quot;referencia\&quot;\n\n    Usuario ||--o{ TurnoCaja : \&quot;opera\&quot;\n    TurnoCaja ||--o{ Venta : \&quot;agrupa\&quot;\n    Usuario ||--o{ Venta : \&quot;registra\&quot;\n\n    Venta ||--|{ DetalleVenta : \&quot;conforma\&quot;\n    Producto ||--o{ DetalleVenta : \&quot;referencia\&quot;\n\n    Venta ||--|{ HistorialEstadoVenta : \&quot;audita\&quot;\n    EstadoVenta ||--o{ HistorialEstadoVenta : \&quot;define\&quot;\n\n    Rol {\n        int idRol PK\n        string nombre\n        string descripcion\n    }\n\n    Permiso {\n        int idPermiso PK\n        string nombre\n        string modulo\n        string descripcion\n    }\n\n    RolPermiso {\n        int idRolPermiso PK\n        int idRol FK\n        int idPermiso FK\n    }\n\n    Usuario {\n        int idUsuario PK\n        int idRol FK\n        string nombreUsuario\n        string contrasenia\n        string nombreCompleto\n        boolean estado\n    }\n\n    Marca {\n        int idMarca PK\n        string nombre\n        boolean estado\n    }\n\n    TipoProducto {\n        int idTipoProducto PK\n        string nombre\n        string descripcion\n    }\n\n    Producto {\n        int idProducto PK\n        int idMarca FK\n        int idTipoProducto FK\n        string codigoBarras\n        string descripcion\n        decimal precioCosto\n        decimal precioVenta\n        int stockActual\n        int stockMinimo\n        boolean estado\n    }\n\n    Proveedor {\n        int idProveedor PK\n        string razonSocial\n        string cuit\n        string direccion\n        string telefono\n        boolean estado\n    }\n\n    Compra {\n        int idCompra PK\n        int idProveedor FK\n        int idUsuario FK\n        string nroComprobante\n        datetime fechaHora\n        decimal total\n    }\n\n    DetalleCompra {\n        int idDetalleCompra PK\n        int idCompra FK\n        int idProducto FK\n        int cantidad\n        decimal costoUnitario\n        decimal subtotal\n    }\n\n    TurnoCaja {\n        int idTurno PK\n        int idUsuario FK\n        datetime fechaHoraApertura\n        datetime fechaHoraCierre\n        decimal montoInicial\n        decimal totalVentasEfectivo\n        decimal totalVentasTransferencia\n        decimal saldoTeoricoSistema\n        decimal saldoRealFisico\n        decimal diferencia\n        string observaciones\n        string estado\n    }\n\n    EstadoVenta {\n        int idEstadoVenta PK\n        string nombre\n        string descripcion\n    }\n\n    Venta {\n        int idVenta PK\n        int idTurno FK\n        int idUsuario FK\n        string nroTicket\n        datetime fechaHora\n        decimal total\n        string medioPago\n        decimal montoRecibido\n        decimal vuelto\n        string comprobantePago\n    }\n\n    DetalleVenta {\n        int idDetalleVenta PK\n        int idVenta FK\n        int idProducto FK\n        int cantidad\n        decimal precioCobrado\n        decimal costoHistorico\n        decimal subtotal\n    }\n\n    HistorialEstadoVenta {\n        int idHistorial PK\n        int idVenta FK\n        int idEstadoVenta FK\n        datetime fechaHora\n        string observaciones\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qy1J14IzSJVxeLF2s98s-744">
