<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="oHsMjxlxJmw-THNe20cB">
    <mxGraphModel dx="3289" dy="2269" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor V as Vendedor / Operador\n    participant F as &lt;&lt;Boundary&gt;&gt; PantallaMostradorVentas\n    participant C as &lt;&lt;Control&gt;&gt; GestorVentas\n    participant EP as &lt;&lt;Entity&gt;&gt; Producto\n    participant EV as &lt;&lt;Entity&gt;&gt; Venta\n    participant ETC as &lt;&lt;Entity&gt;&gt; TurnoCaja\n    participant EH as &lt;&lt;Entity&gt;&gt; HistorialEstadoVenta\n\n    V-&gt;&gt;F: Abrir mostrador de ventas (F1)\n    F-&gt;&gt;C: inicializarMostrador(idTurnoActivo)\n    C-&gt;&gt;ETC: verificarEstadoTurno(idTurnoActivo)\n    ETC--&gt;&gt;C: turnoAbierto: true\n    C--&gt;&gt;F: mostradorListo()\n\n    loop Para cada producto del cliente\n        V-&gt;&gt;F: ingresarCodigoOCantidad(codigoBarras, cantidad)\n        F-&gt;&gt;C: agregarArticulo(codigoBarras, cantidad)\n        C-&gt;&gt;EP: verificarStock(codigoBarras, cantidad)\n        alt Stock disponible insuficiente (CU029)\n            EP--&gt;&gt;C: stockInsuficiente(stockActual)\n            C--&gt;&gt;F: notificarAlertaStock(stockActual)\n        else Stock disponible suficiente\n            EP--&gt;&gt;C: datosProducto(descripcion, precioVenta, costo)\n            C-&gt;&gt;C: calcularSubtotal(cantidad, precioVenta)\n            C--&gt;&gt;F: mostrarItemEnGrilla(descripcion, cantidad, precioVenta, subtotal)\n            C--&gt;&gt;F: actualizarTotalACobrar(totalAcumulado)\n        end\n    end\n\n    V-&gt;&gt;F: seleccionarMedioPago(tipoPago, montoAbonado, nroComprobante)\n    alt Pago en Efectivo\n        F-&gt;&gt;C: liquidarVuelto(totalAcumulado, montoAbonado)\n        C-&gt;&gt;C: calcularVuelto(CU030)\n        C--&gt;&gt;F: mostrarVuelto(vueltoCalculado)\n    else Pago por Transferencia\n        F-&gt;&gt;C: registrarComprobanteTransferencia(nroComprobante)\n        C--&gt;&gt;F: validarComprobanteDigital()\n    end\n\n    V-&gt;&gt;F: presionarConfirmarVenta()\n    F-&gt;&gt;C: procesarVenta(datosVenta, listaItems, tipoPago)\n    \n    activate C\n    C-&gt;&gt;EV: crearVenta(nroTicket, total, tipoPago, montoAbonado, vuelto)\n    loop Por cada ítem confirmado\n        C-&gt;&gt;EV: agregarDetalle(idProducto, cantidad, precioCobrado, costo)\n        C-&gt;&gt;EP: descontarStock(idProducto, cantidad) (CU026)\n    end\n    C-&gt;&gt;EH: registrarEstado(\&quot;COBRADA\&quot;, fechaHora, \&quot;Cobro completado\&quot;)\n    C-&gt;&gt;ETC: acumularVentaAlTurno(tipoPago, total)\n    deactivate C\n\n    C--&gt;&gt;F: notificarVentaExitosa(nroTicket)\n    F--&gt;&gt;V: Exhibir comprobante comercial y limpiar mostrador&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="l6qpG23EMiPaR0Z-BCAZ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
