<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="ixpEbQCbwoaVc-s1EjAV">
    <mxGraphModel dx="1919" dy="1129" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Rol {\n        -int idRol\n        -String nombre\n        -String descripcion\n        +getNombre() String\n        +setNombre(String nombre) void\n    }\n\n    class Usuario {\n        -int idUsuario\n        -String nombreUsuario\n        -String contrasenia\n        -String nombreCompleto\n        -boolean estado\n        +autenticar(String pass) boolean\n        +cambiarEstado(boolean nuevoEstado) void\n        +tienePermiso(String modulo) boolean\n        +getRol() Rol\n    }\n\n    class Marca {\n        -int idMarca\n        -String nombre\n        -boolean estado\n        +getNombre() String\n        +setNombre(String nombre) void\n    }\n\n    class TipoProducto {\n        -int idTipoProducto\n        -String nombre\n        -String descripcion\n        +getNombre() String\n        +setNombre(String nombre) void\n    }\n\n    class Producto {\n        -int idProducto\n        -String codigoBarras\n        -String descripcion\n        -double precioVenta\n        -double precioCosto\n        -int stockActual\n        -int stockMinimo\n        -boolean estado\n        +actualizarStock(int cantidad) void\n        +validarDisponibilidad(int cant) boolean\n        +esStockCritico() boolean\n        +getStockActual() int\n    }\n\n    class Proveedor {\n        -int idProveedor\n        -String razonSocial\n        -String cuit\n        -String direccion\n        -String telefono\n        -boolean estado\n        +getRazonSocial() String\n        +getCuit() String\n    }\n\n    class Compra {\n        -int idCompra\n        -String nroComprobante\n        -String fechaHora\n        -double total\n        +agregarDetalle(Producto p, int cant, double costo) void\n        +quitarDetalle(DetalleCompra item) void\n        +calcularTotal() double\n        +confirmarIngresoMercaderia() void\n    }\n\n    class DetalleCompra {\n        -int idDetalleCompra\n        -int cantidad\n        -double costoUnitario\n        -double subtotal\n        +calcularSubtotal() double\n        +getSubtotal() double\n    }\n\n    class EstadoVenta {\n        -int idEstadoVenta\n        -String nombre\n        -String descripcion\n        +getNombre() String\n        +setNombre(String nombre) void\n    }\n\n    class HistorialEstadoVenta {\n        -int idHistorial\n        -String fechaHora\n        -String observaciones\n        +getFechaHora() String\n        +getEstado() EstadoVenta\n    }\n\n    class Venta {\n        -int idVenta\n        -String nroTicket\n        -String fechaHora\n        -double total\n        -String medioPago\n        -double montoRecibido\n        -double vuelto\n        -String comprobantePago\n        +agregarItem(Producto p, int cantidad) void\n        +quitarItem(DetalleVenta item) void\n        +calcularTotal() double\n        +liquidarVuelto(double montoRecibido) double\n        +cambiarEstado(EstadoVenta e, String obs) void\n        +getEstadoActual() EstadoVenta\n        +registrarCobro() void\n    }\n\n    class DetalleVenta {\n        -int idDetalleVenta\n        -int cantidad\n        -double precioCobrado\n        -double costoHistorico\n        -double subtotal\n        +calcularSubtotal() double\n        +getSubtotal() double\n    }\n\n    class TurnoCaja {\n        -int idTurno\n        -String fechaHoraApertura\n        -String fechaHoraCierre\n        -double montoInicial\n        -double totalVentasEfectivo\n        -double totalVentasTransferencia\n        -double saldoTeoricoSistema\n        -double saldoRealFisico\n        -double diferencia\n        -String observaciones\n        -String estado\n        +abrirTurno(double montoBase) void\n        +acumularVenta(Venta v) void\n        +conciliarSaldo(double montoContado, String obs) void\n        +cerrarTurno() void\n    }\n\n    %% Seguridad y Paramétricas Maestras\n    Usuario \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Rol : asignado\n    Producto \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Marca : clasificado en\n    Producto \&quot;0..*\&quot; --&gt; \&quot;1\&quot; TipoProducto : categorizado en\n\n    %% Módulo de Compras / Abastecimiento\n    Compra \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Usuario : asienta\n    Compra \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Proveedor : despacha\n    Compra \&quot;1\&quot; *-- \&quot;1..*\&quot; DetalleCompra : contiene\n    DetalleCompra \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Producto : referencia\n\n    %% Módulo de Caja y Ventas (Relación única de Agregación)\n    TurnoCaja \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Usuario : opera\n    TurnoCaja \&quot;1\&quot; o-- \&quot;0..*\&quot; Venta : agrupa\n\n    %% Módulo de Ventas y Composición de Detalle\n    Venta \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Usuario : registra\n    Venta \&quot;1\&quot; *-- \&quot;1..*\&quot; DetalleVenta : conformada por\n    DetalleVenta \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Producto : referencia\n\n    %% Trazabilidad de Estados de la Venta\n    Venta \&quot;1\&quot; *-- \&quot;1..*\&quot; HistorialEstadoVenta : audita cambios\n    HistorialEstadoVenta \&quot;0..*\&quot; --&gt; \&quot;1\&quot; EstadoVenta : refiere a&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZjhvzxDjDHvcqKoMGfue-356">
