<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- Menú de navegación; MenuPrincipalController habilita módulos según el rol. -->
<BorderPane fx:controller="com.jrmarket.controller.MenuPrincipalController" prefHeight="700.0" prefWidth="960.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   
   <!-- CABECERA INSTITUCIONAL -->
   <top>
      <VBox BorderPane.alignment="CENTER" spacing="0.0">
         <children>
            <ToolBar>
               <items>
                  <Label text="JRMARKET v1.0 | Sistema de Gestión y Punto de Venta">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </items>
            </ToolBar>
            
            <!-- FRANJA DE OPERADOR AUTENTICADO -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-padding: 8 15 8 15; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label text="Usuario en Sesión:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblUsuario" text="Cristian Palmero" textFill="#212121">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  
                  <Separator orientation="VERTICAL" />
                  
                  <Label text="Rol Activo:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblRol" text="ADMINISTRADOR" textFill="#37474f">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <!-- BOTÓN CERRAR SESIÓN ESTANDARIZADO NATIVO -->
                  <Button fx:id="btnCerrarSesion" onAction="#cerrarSesion" prefHeight="28.0" text="Cerrar Sesión" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- CUERPO CON LOS MÓDULOS DEL SISTEMA -->
   <center>
      <VBox BorderPane.alignment="CENTER" alignment="TOP_LEFT" spacing="14.0">
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
         </padding>
         <children>
            
            <VBox spacing="4.0">
               <children>
                  <Label text="MÓDULOS OPERATIVOS DEL SISTEMA" textFill="#212121">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label text="Seleccione una función para acceder a las operaciones del puesto:" textFill="#757575">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <!-- GRILLA DE MÓDULOS -->
            <GridPane VBox.vgrow="ALWAYS" hgap="20.0" vgap="14.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" minWidth="380.0" prefWidth="420.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="380.0" prefWidth="420.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="110.0" prefHeight="125.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="110.0" prefHeight="125.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="110.0" prefHeight="125.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  
                  <!-- MÓDULO F1: VENTAS -->
                  <Button GridPane.columnIndex="0" GridPane.rowIndex="0" alignment="TOP_LEFT" fx:id="btnModuloVentas" maxHeight="Infinity" maxWidth="Infinity" onAction="#abrirVentas" style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;">
                     <graphic>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="[ F1 ] Mostrador de Ventas y Cobro" textFill="#212121">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Atención al público, búsqueda de productos, cálculo de vuelto y emisión de tickets." textFill="#616161" wrapText="true">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- MÓDULO F2: CIERRE Y ARQUEO -->
                  <Button GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="TOP_LEFT" fx:id="btnModuloCierre" maxHeight="Infinity" maxWidth="Infinity" onAction="#abrirCierreCaja" style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;">
                     <graphic>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="[ F2 ] Cierre de Turno y Arqueo" textFill="#212121">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Balance del turno, conciliación física en caja y justificación de desvíos." textFill="#616161" wrapText="true">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- MÓDULO F3: CATÁLOGO -->
                  <Button GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="TOP_LEFT" fx:id="btnModuloCatalogo" maxHeight="Infinity" maxWidth="Infinity" onAction="#abrirCatalogo" style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;">
                     <graphic>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="[ F3 ] Catálogo General y Stock" textFill="#212121">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Consulta de artículos, alertas de faltantes y verificación de existencias." textFill="#616161" wrapText="true">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- MÓDULO F4: COMPRAS Y REPOSICIÓN -->
                  <Button GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="TOP_LEFT" fx:id="btnModuloCompras" maxHeight="Infinity" maxWidth="Infinity" onAction="#abrirCompras" style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;">
                     <graphic>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="[ F4 ] Gestión de Compras y Reposición" textFill="#212121">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Creación de lista sugerida de compras y registro de facturas de mayoristas." textFill="#616161" wrapText="true">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

                  <!-- MÓDULO F5: GESTIÓN DE USUARIOS Y ROLES (ADMINISTRACIÓN) -->
                  <Button GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" alignment="TOP_LEFT" fx:id="btnModuloUsuarios" maxHeight="Infinity" maxWidth="Infinity" onAction="#abrirUsuarios" style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 14; -fx-cursor: hand;">
                     <graphic>
                        <VBox spacing="6.0">
                           <children>
                              <Label text="[ F5 ] Gestión de Usuarios y Permisos" textFill="#212121">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Administración de cuentas de operadores, asignación de roles y control de acceso (restringido a Administrador)." textFill="#616161" wrapText="true">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </graphic>
                  </Button>

               </children>
            </GridPane>

         </children>
      </VBox>
   </center>

   <!-- PIE INFORMATIVO -->
   <bottom>
      <HBox BorderPane.alignment="CENTER" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-padding: 8 15 8 15; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
         <children>
            <Label fx:id="lblEstadoPie" text="Operador en sesión: Cristian Palmero" textFill="#616161">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="JRMARKET POS" textFill="#9e9e9e">
               <font>
                  <Font size="11.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </bottom>

</BorderPane>