<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jrmarket.controller.LoginController">
   
   <!-- CABECERA INSTITUCIONAL ESTANDARIZADA -->
   <top>
      <VBox spacing="0.0" BorderPane.alignment="CENTER">
         <children>
            <ToolBar>
               <items>
                  <Label text="JRMARKET v1.0 | Control de Acceso y Seguridad">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
               </items>
            </ToolBar>
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-padding: 8 15 8 15; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label text="Punto de Venta y Gestión de JRMARKET" textFill="#616161">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- CUERPO PRINCIPAL / FORMULARIO -->
   <center>
      <VBox alignment="CENTER" spacing="16.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="15.0" />
         </padding>
         <children>
            
            <VBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label text="JRMARKET" textFill="#212121">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Autenticación de Operador" textFill="#757575">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <Separator prefWidth="200.0" />

            <!-- CAMPOS DE ENTRADA -->
            <VBox spacing="12.0" style="-fx-background-color: #fafafa; -fx-padding: 16; -fx-border-color: #cfd8dc; -fx-border-radius: 6; -fx-background-radius: 6;">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Usuario:">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtUsuario" onAction="#enfocarClave" prefHeight="32.0" promptText="Nombre de usuario..." />
                     </children>
                  </VBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="Contraseña:">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <PasswordField fx:id="txtClave" onAction="#iniciarSesion" prefHeight="32.0" promptText="••••••••" />
                     </children>
                  </VBox>

                  <Label fx:id="lblMensaje" text="" textFill="#c62828" wrapText="true">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <!-- ACCIONES -->
            <VBox spacing="8.0">
               <children>
                  <Button fx:id="btnIngresar" maxWidth="Infinity" onAction="#iniciarSesion" prefHeight="30.0" text="Acceder [ Enter ]" />
                  <Button fx:id="btnSalir" cancelButton="true" maxWidth="Infinity" onAction="#salir" prefHeight="30.0" text="Salir [ Esc ]" />
               </children>
            </VBox>

            <!-- PIE CON CUENTAS DEMO -->
            <VBox alignment="CENTER" spacing="2.0" style="-fx-background-color: #f5f5f5; -fx-padding: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 4;">
               <children>
                  <Label text="Operadores para prueba de roles:" textFill="#757575">
                     <font>
                        <Font name="System Bold" size="10.0" />
                     </font>
                  </Label>
                  <Label text="cristian (Admin) • lucas (Repositor) • sofia (Vendedor)" textFill="#616161">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
                  <Label text="Clave: 1234" textFill="#9e9e9e">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>