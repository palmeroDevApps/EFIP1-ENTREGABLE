<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- Catálogo compartido entre consulta/ABM y los selectores de Ventas y Compras. -->
<BorderPane prefHeight="650.0" prefWidth="980.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jrmarket.controller.ProductoController">
   
   <!-- CABECERA DE CATÁLOGO -->
   <top>
      <VBox spacing="0.0" BorderPane.alignment="CENTER">
         <children>
            <ToolBar>
               <items>
                  <Label fx:id="lblTituloVentana" text="JRMARKET v1.0 | Catálogo General y Gestión de Productos (ABML)">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </items>
            </ToolBar>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-padding: 8 15 8 15; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label text="Filtro rápido:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtBusqueda" onKeyReleased="#filtrarProductos" prefHeight="30.0" prefWidth="280.0" promptText="Buscar por código, descripción o marca..." />
                  
                  <Separator orientation="VERTICAL" />
                  <Label text="Rubro:" />
                  <ComboBox fx:id="cbFiltroRubro" onAction="#filtrarProductos" prefHeight="30.0" prefWidth="180.0" />

                  <Separator orientation="VERTICAL" />
                  <Label fx:id="lblTotalRegistros" text="Total: 0 artículos" textFill="#616161">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- TABLA DE ARTÍCULOS -->
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código" />
                  <TableColumn fx:id="colMarca" prefWidth="130.0" text="Marca" />
                  <TableColumn fx:id="colDescripcion" prefWidth="280.0" text="Descripción" />
                  <TableColumn fx:id="colRubro" prefWidth="140.0" text="Rubro" />
                  <TableColumn fx:id="colPrecioVenta" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT;" text="Precio Venta" />
                  <TableColumn fx:id="colStockActual" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Stock Actual" />
                  <TableColumn fx:id="colStockMinimo" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Stock Mínimo" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

   <!-- BARRA INFERIOR DE ACCIONES (ABML + MODO SELECCIÓN) -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f5f5f5; -fx-padding: 10 15 10 15; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <children>
            
            <!-- PANEL 1: ACCIONES ABML (ADMINISTRACIÓN GENERAL) -->
            <HBox fx:id="boxAccionesABML" alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="btnNuevo" onAction="#nuevoProducto" prefHeight="32.0" style="-fx-font-weight: bold;" text="[ F5 ] Nuevo Producto" />
                  <Button fx:id="btnModificar" disable="true" onAction="#modificarProducto" prefHeight="32.0" text="[ F6 ] Modificar" />
                  <Button fx:id="btnBaja" disable="true" onAction="#darDeBajaProducto" prefHeight="32.0" text="[ Supr ] Dar de Baja" />
               </children>
            </HBox>

            <!-- Panel selector: la cantidad siempre se solicita aquí; Compras habilita además el costo unitario. -->
            <HBox fx:id="boxSeleccionVenta" alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label text="Cantidad:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Spinner fx:id="spnCantidadModal" prefHeight="32.0" prefWidth="80.0" />
                  <HBox fx:id="boxCostoCompra" alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label text="Costo unitario:" />
                        <TextField fx:id="txtCostoUnitarioModal" prefHeight="32.0" prefWidth="110.0" promptText="0.00" />
                     </children>
                  </HBox>
                  <Button fx:id="btnAgregarVenta" disable="true" onAction="#agregarYVolver" prefHeight="30.0" text="Agregar a la Venta" />
                  <Label text="(o haga doble clic sobre el producto)" textFill="#757575">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrar" onAction="#cerrarVentana" prefHeight="32.0" prefWidth="90.0" text="Cerrar" />
         </children>
      </HBox>
   </bottom>

</BorderPane>